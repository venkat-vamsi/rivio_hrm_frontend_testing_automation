<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Rivio HRMS – smoke suite.

  Runs ONLY methods tagged @Test(groups = {..., "smoke", ...}).
  Smoke tests are the minimum-viable check: auth, basic admin nav,
  unauth redirect, employee directory search.

  Currently in the smoke group:
    auth_validAdminLogin / auth_invalidLogin   (LoginTest)
    dash_kpiCardsNavigate                       (DashboardTest)
    emp_directorySearch                         (EmployeeTest)
    rbac_unauthRedirect                         (RoleAccessTest)
-->
<suite name="Rivio_SmokeSuite" verbose="1" parallel="none" thread-count="1">

    <listeners>
        <listener class-name="com.cts.rivio.utils.ExtentReportListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <groups>
        <run>
            <include name="smoke"/>
        </run>
    </groups>

    <test name="Smoke_All">
        <classes>
            <class name="com.cts.rivio.tests.LoginTest"/>
            <class name="com.cts.rivio.tests.DashboardTest"/>
            <class name="com.cts.rivio.tests.EmployeeTest"/>
            <class name="com.cts.rivio.tests.RoleAccessTest"/>
        </classes>
    </test>

</suite>
