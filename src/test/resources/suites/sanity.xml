<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Rivio_SanitySuite" verbose="1" parallel="none" thread-count="1">

    <listeners>
        <listener class-name="com.cts.rivio.utils.ExtentReportListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <!-- Group-based filter:
         - INCLUDE "regression" — every @Test method is in this group, so we start
           from the full regression set.
         - EXCLUDE "bug" — known-failing defect tests (RV_*_BUG_*) are skipped in
           sanity to keep the suite green.
         - EXCLUDE "dataProvider" — the RoleMatrixTest.everyRoleCanUseSelfService
           20-iteration test is excluded for speed (coverage is already provided
           by the dedicated self-service tests in Sanity_Employee_SelfService).

         The methods filtered out by these groups are EXACTLY the same set that
         the previous <methods><exclude .../></methods> blocks removed — so the
         test list, bucket structure, and reports stay identical. -->
    <groups>
        <run>
            <include name="regression"/>
            <exclude name="bug"/>
            <exclude name="dataProvider"/>
        </run>
    </groups>

    <!-- ═══════════════════════════════════════════════════════════════════════
         ██ ADMIN ROLE BLOCKS ██
         All 8 blocks below share ONE admin login.
         BaseTest's role-bucket mechanism (static currentLoggedInRole) keeps
         the session alive across sequential <test> blocks as long as the role
         stays "ADMIN".  Login cost = 1 UI login for all 8 blocks combined.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── 1. Dashboard ─────────────────────────────────────────────────── -->
    <!-- Bug excluded by group: RV_DASH_BUG_03 (sidebar collapse bug, known fail) -->
    <test name="Sanity_Dashboard">
        <classes>
            <class name="com.cts.rivio.tests.DashboardTest"/>
        </classes>
    </test>
    <!-- Tests included: RV_DASH_001, RV_DASH_002, RV_DASH_003,
                         RV_DASH_004, RV_DASH_005, RV_DASH_006  (6 tests) -->

    <!-- ── 2. Employee Directory ─────────────────────────────────────────── -->
    <!-- Bugs excluded by group: RV_EMP_BUG_01, RV_EMP_BUG_02 (known fails) -->
    <test name="Sanity_Employees">
        <classes>
            <class name="com.cts.rivio.tests.EmployeeTest"/>
        </classes>
    </test>
    <!-- Tests included: RV_EMP_001, RV_EMP_002, RV_EMP_003  (3 tests) -->

    <!-- ── 3. Time & Attendance ──────────────────────────────────────────── -->
    <!-- Bug excluded by group: RV_ATT_003 (Absent checkbox bug, known fail) -->
    <test name="Sanity_Attendance">
        <classes>
            <class name="com.cts.rivio.tests.AttendanceTest"/>
        </classes>
    </test>
    <!-- Tests included: RV_ATT_001, RV_ATT_002, RV_ATT_004, RV_ATT_005  (4 tests) -->

    <!-- ── 4. Leave Approvals (Admin side) ───────────────────────────────── -->
    <!-- No bug tests in LeaveTest. -->
    <test name="Sanity_Leave_Admin">
        <classes>
            <class name="com.cts.rivio.tests.LeaveTest"/>
        </classes>
    </test>
    <!-- Tests included: RV_LVE_001, RV_LVE_002  (2 tests) -->

    <!-- ── 5. Payroll (Admin side) ───────────────────────────────────────── -->
    <!-- No bug tests in PayrollTest. -->
    <test name="Sanity_Payroll_Admin">
        <classes>
            <class name="com.cts.rivio.tests.PayrollTest"/>
        </classes>
    </test>
    <!-- Tests included: RV_PAY_001, RV_PAY_002  (2 tests) -->

    <!-- ── 6. Recruitment Pipeline ───────────────────────────────────────── -->
    <!-- Bug excluded by group: RV_REC_BUG_07 (hire modal autofill bug, known fail) -->
    <test name="Sanity_Recruitment">
        <classes>
            <class name="com.cts.rivio.tests.RecruitmentTest"/>
        </classes>
    </test>
    <!-- Tests included: RV_REC_001, RV_REC_002, RV_REC_003  (3 tests) -->

    <!-- ── 7. Company Structure / Config ─────────────────────────────────── -->
    <!-- No bug tests in CompanyStructureTest. -->
    <test name="Sanity_Company_Structure">
        <classes>
            <class name="com.cts.rivio.tests.CompanyStructureTest"/>
        </classes>
    </test>
    <!-- Tests included: RV_CFG_001 (×2), RV_CFG_002, RV_CFG_004  (4 tests) -->


    <!-- ═══════════════════════════════════════════════════════════════════════
         ██ HR ROLE BLOCK ██
         Login switches from ADMIN → HR here (1 UI login for this block).
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── 9. HR Workflow ────────────────────────────────────────────────── -->
    <!-- Bug excluded by group: RV_HR_BUG_04 (HR Active Pay Cycles KPI routing, known fail) -->
    <test name="Sanity_HR_Workflow">
        <classes>
            <class name="com.cts.rivio.tests.HrWorkflowTest"/>
        </classes>
    </test>
    <!-- Tests included: hr_dashboardLoads, hr_employeesDirectoryLoads,
         hr_leaveApprovalsLoads, hr_recruitmentLoads, hr_attendanceLoads,
         hr_askRiviLoads, hr_payrollIsBlocked, hr_companyIsBlocked  (8 tests) -->


    <!-- ═══════════════════════════════════════════════════════════════════════
         ██ MANAGER ROLE BLOCK ██
         Login switches from HR → Manager here (1 UI login for this block).
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── 10. Manager Workflow ──────────────────────────────────────────── -->
    <!-- No bug tests in ManagerWorkflowTest. -->
    <test name="Sanity_Manager_Workflow">
        <classes>
            <class name="com.cts.rivio.tests.ManagerWorkflowTest"/>
        </classes>
    </test>
    <!-- Tests included: manager_dashboardRedirectsAway,
         manager_employeesDirectoryLoads, manager_leaveApprovalsLoads,
         manager_attendanceLoads, manager_payrollIsBlocked,
         manager_atsIsBlocked, manager_askRiviLoads,
         manager_companyIsBlocked  (8 tests) -->


    <!-- ═══════════════════════════════════════════════════════════════════════
         ██ PAYROLL MANAGER ROLE BLOCK ██
         Login switches from Manager → Payroll Manager (1 UI login).
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── 11. Payroll Manager Workflow ──────────────────────────────────── -->
    <!-- Bug excluded by group: RV_PMW_BUG_09 (PM employee edit access, known fail) -->
    <test name="Sanity_PayrollManager_Workflow">
        <classes>
            <class name="com.cts.rivio.tests.PayrollManagerWorkflowTest"/>
        </classes>
    </test>
    <!-- Tests included: payroll_dashboardLoads, payroll_employeesDirectoryLoads,
         payroll_attendanceLoads, payroll_dashboardIsBlocked, payroll_leaveIsBlocked,
         payroll_atsIsBlocked, payroll_askRiviLoads,
         payroll_companyIsBlocked  (8 tests) -->


    <!-- ═══════════════════════════════════════════════════════════════════════
         ██ EMPLOYEE ROLE BLOCK ██
         Login switches from Payroll Manager → Employee (1 UI login).
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── 12. Employee Self-Service ─────────────────────────────────────── -->
    <!-- Bugs excluded by group: RV_SSP_BUG_10, RV_ATT_BUG_06, RV_LVE_BUG_08 -->
    <test name="Sanity_Employee_SelfService">
        <classes>
            <class name="com.cts.rivio.tests.MyProfileTest"/>
            <!-- Tests included: RV_SSP_002  (1 test) -->

            <class name="com.cts.rivio.tests.MyAttendanceTest"/>
            <!-- Tests included: RV_ATT_006  (1 test) -->

            <class name="com.cts.rivio.tests.MyLeavesTest"/>
            <!-- Tests included: RV_LVE_004, RV_LVE_005  (2 tests) -->

            <class name="com.cts.rivio.tests.MyPayslipsTest"/>
            <!-- Tests included: RV_PAY_005  (1 test) -->

            <class name="com.cts.rivio.tests.EmployeeAccessTest"/>
            <!-- Tests included: employee_dashboardIsBlocked,
                 employee_attendanceIsBlocked, employee_leaveIsBlocked  (3 tests) -->
        </classes>
    </test>


    <!-- ═══════════════════════════════════════════════════════════════════════
         ██ AUTH / MIXED BLOCKS ██  ← ALWAYS LAST
         These classes set getRole() = null, which means each test manages
         its own login/logout via forceLoggedOut() in @BeforeMethod.
         They are placed last so their session resets don't disturb the
         role-bucket sessions above.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── 13. Login Page ────────────────────────────────────────────────── -->
    <!-- No bug tests in LoginTest. -->
    <test name="Sanity_Login">
        <classes>
            <class name="com.cts.rivio.tests.LoginTest"/>
        </classes>
    </test>
    <!-- Tests included: RV_AUTH_001, RV_AUTH_002, RV_AUTH_003,
         RV_AUTH_004, RV_AUTH_005, test_emptyFieldsKeepSubmitDisabled  (6 tests) -->

    <!-- ── 14. Logout ────────────────────────────────────────────────────── -->
    <!-- No bug tests in LogoutTest.
         DataProvider "allRoles" → 5 roles × 2 methods = 10 test runs. -->
    <test name="Sanity_Logout">
        <classes>
            <class name="com.cts.rivio.tests.LogoutTest"/>
        </classes>
    </test>
    <!-- Tests included: logoutLandsOnLogin (×5), authGuardBlocksAfterLogout (×5)
         (10 test runs total via @DataProvider)                               -->

    <!-- ── 15. Role Guards & Security ───────────────────────────────────── -->
    <!-- Bug excluded by group: RV_AI_BUG_05 (employee Ask Rivio access, known fail) -->
    <test name="Sanity_Role_Guards">
        <classes>
            <class name="com.cts.rivio.tests.RoleAccessTest"/>
            <!-- Tests included: unauthenticatedRedirectsToLogin, superAdminSeesAllAdminNav,
                 RV_RBAC_employeeCannotAccessPayroll, managerCannotAccessPayroll,
                 managerCannotAccessCompany, RV_SSP_001_selfServiceSubMenu  (6 tests) -->

            <class name="com.cts.rivio.tests.SecurityAuditTest"/>
            <!-- Tests included: RV_SSP_003, mobileViewportLoginRenders  (2 tests) -->

            <class name="com.cts.rivio.tests.AIPolicyAssistantTest"/>
            <!-- Tests included: adminCanOpenAskRivi, employeeCannotOpenAskRivi  (2 tests) -->
        </classes>
    </test>

    <!-- ── 16. Role Matrix (Sidebar + Self-Service per Role) ─────────────── -->
    <!-- Excluded by group: everyRoleCanUseSelfService — @DataProvider test that
         generates 20 iterations (5 roles × 4 self-service routes). Tagged with
         groups = {"dataProvider"} so the suite-level exclude removes it for
         speed. The individual self-service tests in Sanity_Employee_SelfService
         already verify this coverage. -->
    <test name="Sanity_Role_Matrix">
        <classes>
            <class name="com.cts.rivio.tests.RoleMatrixTest"/>
        </classes>
    </test>
    <!-- Tests included: sidebarItemsForAdmin, sidebarItemsForHr,
         sidebarItemsForManager, sidebarItemsForPayrollManager,
         sidebarItemsForEmployee, askRiviVisibleToAllNonEmployee,
         askRiviHiddenForEmployee  (7 tests) -->

</suite>
