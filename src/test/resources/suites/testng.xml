<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  testng.xml – Full Regression Suite for Rivio HRMS Automation
  Maps to Rivio_HRMS_TestDesign.xlsx scenarios AUTH-S-01 .. SSP-S-02.

  Coverage:
    AUTH-S-01..03 → LoginTest             (RV_AUTH_001..005)
    DASH-S-01..05 → DashboardTest         (RV_DASH_001..006)
    EMP-S-01..04  → EmployeeTest          (RV_EMP_001..004)
    ATT-S-01..05  → AttendanceTest + MyAttendanceTest (RV_ATT_001..006)
    LVE-S-01..04  → LeaveTest + MyLeavesTest          (RV_LVE_001..005)
    PAY-S-01..05  → PayrollTest + MyPayslipsTest      (RV_PAY_001..005)
    REC-S-01..02  → RecruitmentTest                    (RV_REC_001..003)
    CFG-S-01..04  → CompanyStructureTest               (RV_CFG_001)
    SSP-S-01..02  → RoleAccessTest + MyProfileTest + SecurityAuditTest (RV_SSP_001..003)
    Ask Rivi      → AIPolicyAssistantTest
    RBAC          → RoleAccessTest

  Tests scoped out (features missing in Rivio_Angular):
    DocumentManagementTest, PerformanceManagementTest,
    NotificationsTest, TeamCalendarTest
  These still appear so the report shows the full traceability.
-->

<suite name="Rivio_RegressionSuite_Full" verbose="2" parallel="none" thread-count="1">

    <listeners>
        <listener class-name="com.cts.rivio.utils.ExtentReportListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <test name="AUTH_LoginAuthentication">
        <classes>
            <class name="com.cts.rivio.tests.LoginTest"/>
        </classes>
    </test>

    <test name="DASH_AdminDashboard">
        <classes>
            <class name="com.cts.rivio.tests.DashboardTest"/>
        </classes>
    </test>

    <test name="EMP_EmployeeManagement">
        <classes>
            <class name="com.cts.rivio.tests.EmployeeTest"/>
        </classes>
    </test>

    <test name="ATT_TimeAndAttendance">
        <classes>
            <class name="com.cts.rivio.tests.AttendanceTest"/>
            <class name="com.cts.rivio.tests.MyAttendanceTest"/>
        </classes>
    </test>

    <test name="LVE_LeaveManagement">
        <classes>
            <class name="com.cts.rivio.tests.LeaveTest"/>
            <class name="com.cts.rivio.tests.MyLeavesTest"/>
        </classes>
    </test>

    <test name="PAY_PayrollManagement">
        <classes>
            <class name="com.cts.rivio.tests.PayrollTest"/>
            <class name="com.cts.rivio.tests.MyPayslipsTest"/>
        </classes>
    </test>

    <test name="REC_RecruitmentPipeline">
        <classes>
            <class name="com.cts.rivio.tests.RecruitmentTest"/>
        </classes>
    </test>

    <test name="CFG_CompanyConfiguration">
        <classes>
            <class name="com.cts.rivio.tests.CompanyStructureTest"/>
        </classes>
    </test>

    <test name="SSP_SelfServicePortal">
        <classes>
            <class name="com.cts.rivio.tests.MyProfileTest"/>
            <class name="com.cts.rivio.tests.RoleAccessTest"/>
        </classes>
    </test>

    <test name="RoleMatrix_AllRolesAllFeatures">
        <classes>
            <class name="com.cts.rivio.tests.RoleMatrixTest"/>
        </classes>
    </test>

    <test name="HrWorkflow">
        <classes>
            <class name="com.cts.rivio.tests.HrWorkflowTest"/>
        </classes>
    </test>

    <test name="ManagerWorkflow">
        <classes>
            <class name="com.cts.rivio.tests.ManagerWorkflowTest"/>
        </classes>
    </test>

    <test name="PayrollManagerWorkflow">
        <classes>
            <class name="com.cts.rivio.tests.PayrollManagerWorkflowTest"/>
        </classes>
    </test>

    <test name="Logout_AllRoles">
        <classes>
            <class name="com.cts.rivio.tests.LogoutTest"/>
        </classes>
    </test>

    <test name="AI_AskRivi">
        <classes>
            <class name="com.cts.rivio.tests.AIPolicyAssistantTest"/>
        </classes>
    </test>

    <test name="SecurityAndMobile">
        <classes>
            <class name="com.cts.rivio.tests.SecurityAuditTest"/>
        </classes>
    </test>

    <test name="DashboardAnalytics">
        <classes>
            <class name="com.cts.rivio.tests.ReportsAnalyticsTest"/>
        </classes>
    </test>

</suite>
