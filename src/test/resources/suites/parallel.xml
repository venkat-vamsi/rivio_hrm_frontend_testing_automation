<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  parallel.xml  –  Rivio HRMS Parallel Test Suite
  ═══════════════════════════════════════════════════════════════════════════════

  PURPOSE
  ───────
  Runs the SAME tests as testng.xml (regression) but organises the role buckets
  to execute simultaneously in separate browser instances, significantly reducing
  total wall-clock time.

  HOW PARALLELISM WORKS HERE
  ──────────────────────────
  parallel="tests" means TestNG spawns a separate thread for each <test> block.
  thread-count="5" means up to 5 blocks run at the same time.

  With 6 blocks and thread-count="5":
    Round 1 (simultaneous): Admin  │  HR  │  Manager  │  PayrollMgr  │  Employee
    Round 2 (starts when any Round-1 block finishes): Mixed_Auth_And_RoleMatrix

  BROWSER-PER-THREAD SETUP  ← KEY DIFFERENCE FROM testng.xml
  ──────────────────────────────────────────────────────────
  The existing BaseTest creates ONE WebDriver in @BeforeSuite (main thread).
  Because DriverFactory stores drivers in a ThreadLocal, each parallel thread
  needs its own initDriver() call.

  ParallelDriverListener solves this WITHOUT touching any existing Java file:
    • onStart(ITestContext)  → called in the test thread before @BeforeClass
                               → boots a fresh Chrome window for THAT thread
    • onFinish(ITestContext) → called in the test thread after @AfterClass
                               → quits THAT thread's Chrome window

  Result: 5 role-bucket threads each get their own browser.  The main thread
  also opens one browser (from @BeforeSuite) that sits idle and is quit by
  @AfterSuite — that is 6 Chrome windows total in Round 1.


  HOW TO RUN
  ──────────
  mvn test -Dsurefire.suiteXmlFiles=src/test/resources/suites/parallel.xml

  Or right-click parallel.xml in IntelliJ → "Run … parallel.xml"

  EXPECTED OUTCOME
  ─────────────────
  Same pass/fail counts as testng.xml regression.
  Wall-clock time roughly:  max(longest bucket time) + auth bucket time
                            instead of sum(all bucket times).

  COVERAGE (same as testng.xml regression)
  ─────────────────────────────────────────
    Admin_Parallel         → DashboardTest, EmployeeTest, AttendanceTest,
                              LeaveTest, PayrollTest, RecruitmentTest,
                              CompanyStructureTest, ReportsAnalyticsTest
    HR_Parallel            → HrWorkflowTest
    Manager_Parallel       → ManagerWorkflowTest
    PayrollManager_Parallel→ PayrollManagerWorkflowTest
    Employee_Parallel      → MyProfileTest, MyAttendanceTest, MyLeavesTest,
                              MyPayslipsTest, EmployeeAccessTest
    Mixed_Auth_Parallel    → LoginTest, RoleAccessTest, AIPolicyAssistantTest,
                              SecurityAuditTest, RoleMatrixTest, LogoutTest
-->

<suite name="Rivio_ParallelSuite_Full"
       verbose="2"
       parallel="tests"
       thread-count="3"
       preserve-order="true">

    <listeners>
        <!-- ExtentReportListener: logs every test start/pass/fail/skip to HTML.
             Thread-safe: uses ThreadLocal<ExtentTest> internally. -->
        <listener class-name="com.cts.rivio.utils.ExtentReportListener"/>

        <!-- ParallelDriverListener: boots a dedicated Chrome window for each
             <test> thread and quits it when the thread finishes.
             Registered ONLY here — NOT in testng.xml or smoke.xml. -->
        <listener class-name="com.cts.rivio.utils.ParallelDriverListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         THREAD 1 — ADMIN BUCKET  (Super Admin role)
         Runs in parallel with HR, Manager, PayrollMgr, Employee threads.
         ParallelDriverListener opens a dedicated Chrome window for this thread.
         ═══════════════════════════════════════════════════════════════════ -->
    <test name="Admin_Parallel">
        <classes>
            <class name="com.cts.rivio.tests.DashboardTest"/>
            <class name="com.cts.rivio.tests.EmployeeTest"/>
            <class name="com.cts.rivio.tests.AttendanceTest"/>
            <class name="com.cts.rivio.tests.LeaveTest"/>
            <class name="com.cts.rivio.tests.PayrollTest"/>
            <class name="com.cts.rivio.tests.RecruitmentTest"/>
            <class name="com.cts.rivio.tests.CompanyStructureTest"/>
            <class name="com.cts.rivio.tests.ReportsAnalyticsTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════════
         THREAD 2 — HR BUCKET
         Runs simultaneously with Admin, Manager, PayrollMgr, Employee.
         ═══════════════════════════════════════════════════════════════════ -->
    <test name="HR_Parallel">
        <classes>
            <class name="com.cts.rivio.tests.HrWorkflowTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════════
         THREAD 3 — MANAGER BUCKET
         ═══════════════════════════════════════════════════════════════════ -->
    <test name="Manager_Parallel">
        <classes>
            <class name="com.cts.rivio.tests.ManagerWorkflowTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════════
         THREAD 4 — PAYROLL MANAGER BUCKET
         ═══════════════════════════════════════════════════════════════════ -->
    <test name="PayrollManager_Parallel">
        <classes>
            <class name="com.cts.rivio.tests.PayrollManagerWorkflowTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════════
         THREAD 5 — EMPLOYEE BUCKET  (Self-service + access denials)
         ═══════════════════════════════════════════════════════════════════ -->
    <test name="Employee_Parallel">
        <classes>
            <class name="com.cts.rivio.tests.MyProfileTest"/>
            <class name="com.cts.rivio.tests.MyAttendanceTest"/>
            <class name="com.cts.rivio.tests.MyLeavesTest"/>
            <class name="com.cts.rivio.tests.MyPayslipsTest"/>
            <class name="com.cts.rivio.tests.EmployeeAccessTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════════
         THREAD 6 — MIXED / AUTH BUCKET
         These test classes manage their own logins (getRole() == null), so
         they are kept in their own bucket.

         With thread-count="5" and 6 blocks, this block starts as soon as
         any of the 5 role-bucket threads above finishes — typically the HR
         or Manager thread (shortest buckets).

         WHY KEEP THIS SEQUENTIAL WITH ITSELF:
         The test classes here do multiple logins per test (LoginTest,
         LogoutTest, RoleMatrixTest all loop over all 5 roles).  Running
         them all in the same thread prevents them from interfering with
         each other via the shared static currentLoggedInRole field.
         ═══════════════════════════════════════════════════════════════════ -->
    <test name="Mixed_Auth_And_RoleMatrix_Parallel">
        <classes>
            <class name="com.cts.rivio.tests.LoginTest"/>
            <class name="com.cts.rivio.tests.RoleAccessTest"/>
            <class name="com.cts.rivio.tests.AIPolicyAssistantTest"/>
            <class name="com.cts.rivio.tests.SecurityAuditTest"/>
            <class name="com.cts.rivio.tests.RoleMatrixTest"/>
            <class name="com.cts.rivio.tests.LogoutTest"/>
        </classes>
    </test>

</suite>
