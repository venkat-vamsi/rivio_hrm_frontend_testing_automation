<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  parallel-testng.xml – Parallel execution suite.

  parallel="classes" → each test class runs in a separate thread.
  thread-count="4"   → 4 browser instances open simultaneously.

  IMPORTANT: DriverFactory uses ThreadLocal<WebDriver> to ensure
  each thread gets its own WebDriver instance – no shared state.
-->

<suite name="Rivio_ParallelSuite" verbose="1" parallel="classes" thread-count="4">

    <listeners>
        <listener class-name="com.cts.rivio.utils.ExtentReportListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <test name="ParallelRegressionTests">
        <classes>
            <class name="com.cts.rivio.tests.LoginTest"/>
            <class name="com.cts.rivio.tests.DashboardTest"/>
            <class name="com.cts.rivio.tests.EmployeeTest"/>
            <class name="com.cts.rivio.tests.LeaveTest"/>
            <class name="com.cts.rivio.tests.AttendanceTest"/>
            <class name="com.cts.rivio.tests.PayrollTest"/>
            <class name="com.cts.rivio.tests.RecruitmentTest"/>
            <class name="com.cts.rivio.tests.CompanyStructureTest"/>
            <class name="com.cts.rivio.tests.MyProfileTest"/>
            <class name="com.cts.rivio.tests.MyLeavesTest"/>
            <class name="com.cts.rivio.tests.MyPayslipsTest"/>
            <class name="com.cts.rivio.tests.MyAttendanceTest"/>
            <class name="com.cts.rivio.tests.RoleAccessTest"/>
        </classes>
    </test>

</suite>
