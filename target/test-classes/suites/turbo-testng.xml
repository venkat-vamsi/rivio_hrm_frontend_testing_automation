<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  turbo-testng.xml – Maximum-speed parallel execution.

  parallel="methods" thread-count="6" → individual @Test methods run on 6 threads.
  Expected wallclock: 5–10 minutes for the full suite on a decent laptop.

  When to use this:
    - You want the fastest possible feedback loop.
    - Your machine has >=16GB RAM (6 Chrome processes can hit 8GB easily).
    - The Vercel backend is responsive (avoid running during deploys).

  When NOT to use this:
    - First time running after big code changes — start with parallel-testng.xml
      (classes-level) to surface fewer race conditions.
    - On the CI free tier — limit to thread-count="2".

  Each thread has its own browser via DriverFactory.ThreadLocal<WebDriver>,
  so cross-test contamination is impossible. But the live Vercel backend is
  shared across threads — if a test mutates data (approving a leave, creating
  a candidate), parallel runs can see each other's writes. The Rivio_Angular
  app is mostly read-only in our tests, so this is acceptable.
-->

<suite name="Rivio_TurboSuite" verbose="1" parallel="methods" thread-count="6">

    <listeners>
        <listener class-name="com.cts.rivio.utils.ExtentReportListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <test name="TurboAll">
        <classes>
            <class name="com.cts.rivio.tests.LoginTest"/>
            <class name="com.cts.rivio.tests.DashboardTest"/>
            <class name="com.cts.rivio.tests.EmployeeTest"/>
            <class name="com.cts.rivio.tests.AttendanceTest"/>
            <class name="com.cts.rivio.tests.LeaveTest"/>
            <class name="com.cts.rivio.tests.PayrollTest"/>
            <class name="com.cts.rivio.tests.RecruitmentTest"/>
            <class name="com.cts.rivio.tests.CompanyStructureTest"/>
            <class name="com.cts.rivio.tests.MyProfileTest"/>
            <class name="com.cts.rivio.tests.MyLeavesTest"/>
            <class name="com.cts.rivio.tests.MyAttendanceTest"/>
            <class name="com.cts.rivio.tests.MyPayslipsTest"/>
            <class name="com.cts.rivio.tests.RoleAccessTest"/>
            <class name="com.cts.rivio.tests.RoleMatrixTest"/>
            <class name="com.cts.rivio.tests.HrWorkflowTest"/>
            <class name="com.cts.rivio.tests.ManagerWorkflowTest"/>
            <class name="com.cts.rivio.tests.PayrollManagerWorkflowTest"/>
            <class name="com.cts.rivio.tests.AIPolicyAssistantTest"/>
            <class name="com.cts.rivio.tests.SecurityAuditTest"/>
            <class name="com.cts.rivio.tests.ReportsAnalyticsTest"/>
            <class name="com.cts.rivio.tests.LogoutTest"/>
        </classes>
    </test>

</suite>
